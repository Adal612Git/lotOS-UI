{
  "name": "@lotosui/core",
  "version": "0.1.0",
  "description": "LotOS UI Core - design tokens, contracts, RTL engine. Zero framework dependencies.",
  "license": "MIT",
  "author": "Lotos Technologies <lotos@lotos.dev>",
  "homepage": "https://lotos-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/lotos-technologies/lotos-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens/index.js",
      "types": "./dist/tokens/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@lotosui/registry": "workspace:*",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
