@page
@model LotosUi.Dotnet.Examples.Pages.IndexModel
@using System.Collections.Generic

<section style="background:#0f172a;color:#e2e8f0;padding:24px;border-radius:24px;border:1px solid #1e293b;font-family:Segoe UI, sans-serif;">
    <div style="display:grid;gap:18px;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
            <div>
                <p style="margin:0;color:#38bdf8;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;">LotOS Dotnet</p>
                <h1 style="margin:6px 0 0;font-size:30px;">Ops Console</h1>
            </div>
            @await Html.PartialAsync("LotosUI/_Badge", new Dictionary<string, object?> { ["label"] = "Production track", ["variant"] = "success" })
        </div>

        @await Html.PartialAsync("LotosUI/_Card", new Dictionary<string, object?>
        {
            ["title"] = "Queue health",
            ["subtitle"] = "Stable",
            ["body"] = "<p style=\"margin:0;color:#94a3b8;\">Stable response windows across the last 12 hours.</p>",
        })

        @await Html.PartialAsync("LotosUI/_Form", new Dictionary<string, object?>
        {
            ["title"] = "Dispatch approval",
            ["description"] = "Review critical queue changes before release.",
            ["action"] = "#",
            ["method"] = "post",
            ["submitLabel"] = "Approve batch",
            ["body"] = "<label style=\"display:grid;gap:8px;\"><span style=\"font-size:13px;font-weight:700;\">Owner</span><input type=\"text\" placeholder=\"Mia Solis\" style=\"padding:10px 12px;border-radius:12px;border:1px solid #334155;background:#020617;color:#e2e8f0;\" /><small style=\"color:#94a3b8;\">Use the current incident owner</small></label>",
        })

        @await Html.PartialAsync("LotosUI/_Table", new Dictionary<string, object?>
        {
            ["caption"] = "Queue summary",
            ["columns"] = Model.QueueColumns,
            ["rows"] = Model.QueueRows,
            ["emptyState"] = "No queued work",
        })

        @await Html.PartialAsync("LotosUI/_Modal", new Dictionary<string, object?>
        {
            ["title"] = "Escalation notice",
            ["description"] = "Customers in tier A will be notified immediately.",
            ["body"] = "<p style=\"margin:0;color:#cbd5e1;\">Proceed only after owner confirmation.</p>",
            ["footer"] = "<button type=\"button\" style=\"padding:10px 14px;border-radius:14px;border:1px solid #38bdf8;background:transparent;color:#38bdf8;font-weight:700;\">Acknowledge</button>",
        })
    </div>
</section>
