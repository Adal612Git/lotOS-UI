@model IDictionary<string, object?>
@{
    var title = Model.TryGetValue("title", out var titleValue) ? titleValue?.ToString() ?? "Card" : "Card";
    var subtitle = Model.TryGetValue("subtitle", out var subtitleValue) ? subtitleValue?.ToString() : null;
    var body = Model.TryGetValue("body", out var bodyValue) ? bodyValue?.ToString() ?? string.Empty : string.Empty;
    var footer = Model.TryGetValue("footer", out var footerValue) ? footerValue?.ToString() : null;
}
<article style="padding:18px;border-radius:20px;background:#111c33;border:1px solid #22304b;">
    <header style="margin-bottom:12px;">
        <h3 style="margin:0;font-size:18px;">@title</h3>
        @if (!string.IsNullOrWhiteSpace(subtitle))
        {
            <p style="margin:6px 0 0;color:#94a3b8;">@subtitle</p>
        }
    </header>
    @Html.Raw(body)
    @if (!string.IsNullOrWhiteSpace(footer))
    {
        <footer style="margin-top:14px;">@Html.Raw(footer)</footer>
    }
</article>
