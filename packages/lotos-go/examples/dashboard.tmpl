{{ define "dashboard" }}
<!DOCTYPE html>
<html lang="en">
<body>
  <section style="background:#0f172a;color:#e2e8f0;padding:24px;border-radius:24px;border:1px solid #1e293b;font-family:Segoe UI, sans-serif;">
    <div style="display:grid;gap:18px;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
        <div>
          <p style="margin:0;color:#38bdf8;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;">LotOS Go</p>
          <h1 style="margin:6px 0 0;font-size:30px;">Ops Console</h1>
        </div>
        {{ template "lotos_badge" .Badge }}
      </div>

      {{ template "lotos_card" .Card }}
      {{ template "lotos_form" .Form }}
      {{ template "lotos_table" .Table }}
      {{ template "lotos_modal" .Modal }}
    </div>
  </section>
</body>
</html>
{{ end }}
