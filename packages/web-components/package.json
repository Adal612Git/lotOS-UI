{
  "name": "@lotosui/web-components",
  "version": "0.1.0",
  "description": "LotOS UI Web Components prototype - framework-agnostic custom elements powered by @lotosui/core tokens.",
  "license": "MIT",
  "author": "Lotos Technologies <lotos@lotos.dev>",
  "homepage": "https://lotos-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/lotos-technologies/lotos-ui.git",
    "directory": "packages/web-components"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./button": {
      "import": "./dist/button.js",
      "types": "./dist/button.d.ts"
    },
    "./input": {
      "import": "./dist/input.js",
      "types": "./dist/input.d.ts"
    },
    "./badge": {
      "import": "./dist/badge.js",
      "types": "./dist/badge.d.ts"
    },
    "./card": {
      "import": "./dist/card.js",
      "types": "./dist/card.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lotosui/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5.7.2"
  }
}
