{
    "name": "@lotos/cli",
    "version": "0.0.1",
    "description": "LotOS UI CLI — add components, start MCP server, manage registry.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "lotos-ui": "./dist/index.js"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "test": "vitest run",
        "check-types": "tsc --noEmit",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.15.3",
        "typescript": "^5.7.2",
        "vitest": "^2.0.0"
    },
    "dependencies": {
        "@lotos/core": "workspace:*",
        "commander": "^12.0.0",
        "ora": "^8.0.0",
        "chalk": "^5.3.0",
        "fs-extra": "^11.2.0"
    }
}
