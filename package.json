{
  "name": "lotos-ui",
  "private": true,
  "scripts": {
    "build": "node ONE/run-build.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "diagnose:local-env": "node ONE/diagnose-local-toolchain.mjs",
    "verify:structure": "node ONE/check-structure.mjs",
    "verify:degraded": "node ONE/degraded-mode.mjs",
    "verify:runtimes": "node ONE/verify-runtime-surface.mjs",
    "verify:runtime-examples": "node ONE/verify-runtime-examples.mjs",
    "verify:runtime-contracts": "node ONE/verify-runtime-contracts.mjs",
    "verify:desktop": "node ONE/verify-desktop-pipelines.mjs",
    "verify:sales": "node ONE/verify-sales-surface.mjs",
    "verify:go-live": "node ONE/verify-go-live-checkout.mjs",
    "verify:commercial": "node ONE/verify-commercial-readiness.mjs",
    "verify:paid-preview": "node ONE/verify-paid-preview.mjs",
    "verify:ops": "node ONE/verify-ops-readiness.mjs",
    "verify:release-readiness": "node ONE/verify-release-readiness.mjs",
    "verify:registry": "pnpm --filter @lotosui/registry build && node ONE/verify-registry.mjs",
    "verify:mcp": "pnpm --filter @lotosui/registry build && pnpm --filter @lotosui/core build && node ONE/verify-mcp.mjs",
    "verify:templates": "pnpm --filter @lotosui/registry build && node ONE/verify-templates.mjs",
    "verify:registry-runtimes": "pnpm --filter @lotosui/registry build && node ONE/verify-registry-runtimes.mjs",
    "verify:no-secrets": "node ONE/verify-no-secrets.mjs",
    "verify:no-premium-leak": "pnpm --filter @lotosui/registry build && node ONE/verify-no-premium-leak.mjs",
    "verify:ai": "pnpm --filter @lotosui/registry verify:ai && pnpm --filter @lotosui/core build && node ONE/verify-ai-console.mjs",
    "verify:generated-ai": "pnpm --filter @lotosui/registry build && node packages/registry/scripts/generate-ai-manifests.mjs --check && node ONE/verify-generated-ai.mjs",
    "verify:registry-consumers": "pnpm --filter @lotosui/registry build && pnpm --filter @lotosui/core build && node ONE/verify-registry-consumers.mjs",
    "verify:drift": "pnpm run verify:generated-ai && pnpm run verify:registry-consumers",
    "verify:routes": "pnpm --filter @lotosui/registry build && node ONE/verify-routes.mjs",
    "verify:web-smoke": "node ONE/verify-web-smoke.mjs",
    "verify:mcp-smoke": "pnpm --filter @lotosui/registry build && pnpm --filter @lotosui/core build && node ONE/verify-mcp-smoke.mjs",
    "verify:cli-smoke": "pnpm --filter @lotosui/registry build && pnpm --filter @lotosui/core build && pnpm --filter @lotosui/cli build && node ONE/verify-cli-smoke.mjs",
    "verify:package-exports": "pnpm --filter @lotosui/registry build && pnpm --filter @lotosui/core build && pnpm --filter @lotosui/sentinel build && pnpm --filter @lotosui/cli build && pnpm --filter @lotosui/claude-arm build && pnpm --filter @lotosui/web-components build && node ONE/verify-package-exports.mjs",
    "verify:packages": "node ONE/verify-packages.mjs",
    "verify:ci": "node ONE/verify-ci.mjs",
    "verify:entitlement-boundary": "pnpm --filter @lotosui/registry build && node ONE/verify-entitlement-boundary.mjs",
    "verify:webhook-lifecycle": "node ONE/verify-webhook-lifecycle.mjs",
    "verify:webhook-contracts": "node ONE/verify-webhook-contracts.mjs",
    "verify:entitlement-state-machine": "node ONE/verify-entitlement-state-machine.mjs",
    "verify:supabase-migrations": "node ONE/verify-supabase-migrations.mjs",
    "verify:entitlement-audit": "node ONE/verify-entitlement-audit.mjs",
    "verify:admin-lifecycle": "node ONE/verify-admin-lifecycle.mjs",
    "verify:vault-lifecycle": "node ONE/verify-vault-lifecycle.mjs",
    "verify:rls-policy-plan": "node ONE/verify-rls-policy-plan.mjs",
    "verify:commercial-lifecycle": "pnpm --filter @lotosui/registry build && node ONE/verify-commercial-lifecycle.mjs",
    "release:public-tree:check": "node ONE/check-public-tree.mjs --report .release/public-tree-report.json",
    "verify:public-docs": "node ONE/verify-public-docs.mjs",
    "verify:public-ai-context": "pnpm --filter @lotosui/registry build && pnpm --filter @lotosui/core build && node ONE/verify-public-ai-context.mjs",
    "verify:npm-tarballs": "node ONE/verify-npm-tarballs.mjs",
    "verify:premium-stubs": "pnpm --filter @lotosui/registry build && node ONE/verify-premium-stubs.mjs",
    "verify:public-clean-room": "node ONE/verify-public-clean-room.mjs",
    "verify:private-workspace": "node ONE/verify-release-gate.mjs --mode=private",
    "verify:public-release": "pnpm run verify:public-clean-room",
    "verify:release-candidate": "node ONE/verify-release-candidate.mjs",
    "release:notes": "pnpm --filter @lotosui/registry build && node ONE/generate-release-notes.mjs",
    "verify:100": "node ONE/verify-100.mjs",
    "export:commercial": "node ONE/export-commercial-bundles.mjs",
    "prep:paid-preview": "node ONE/prepare-paid-preview.mjs",
    "prep:first-sale": "node ONE/prepare-first-sale.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "puppeteer-core": "^24.37.5"
  }
}
