{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "MCP_PORT",
    "NODE_ENV",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "AUTH_SECRET",
    "NEXTAUTH_SECRET",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "LEMON_WEBHOOK_SECRET",
    "LEMON_STORE_SLUG",
    "LEMON_SOLO_VARIANT_ID",
    "LEMON_PRO_VARIANT_ID",
    "LEMON_LAUNCH_VARIANT_ID",
    "ENTITLEMENT_AUDIT_HASH_PEPPER",
    "LOTOS_OWNER_EMAILS",
    "LOTOS_TESTER_PHONE_HASHES",
    "LOTOS_CONTACT_SALES_URL",
    "LOTOS_BOOKING_URL",
    "LOTOS_SOLO_CHECKOUT_URL",
    "LOTOS_SOLO_PAYPAL_URL",
    "LOTOS_PRO_CHECKOUT_URL",
    "LOTOS_PRO_PAYPAL_URL",
    "LOTOS_LAUNCH_PACK_URL",
    "LOTOS_LAUNCH_PACK_PAYPAL_URL",
    "LOTOS_PREMIUM_PREVIEW_URL",
    "LOTOS_PRIVATE_ASSETS_ROOT",
    "LOTOS_PROVIDER_LEGAL_NAME",
    "LOTOS_PROVIDER_RFC",
    "LOTOS_PROVIDER_ADDRESS",
    "LOTOS_PROVIDER_EMAIL",
    "LOTOS_SUPPORT_EMAIL",
    "LOTOS_SUPPORT_HOURS",
    "LOTOS_SUBSCRIPTION_PORTAL_URL",
    "VERCEL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.*"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:a11y": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:mcp": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
